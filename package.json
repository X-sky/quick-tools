{
  "name": "quick-tools",
  "displayName": "Quick tools",
  "version": "0.0.1",
  "private": true,
  "description": "Quick tools for anything",
  "author": "x-sky",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "turbo dev",
    "dev:extension": "pnpm --filter @quick-tools/extension dev",
    "dev:desktop": "pnpm --filter @quick-tools/desktop dev",
    "dev:tauri": "pnpm --filter @quick-tools/desktop dev:tauri",
    "build:extension": "pnpm --filter @quick-tools/extension build",
    "build:desktop": "pnpm --filter @quick-tools/desktop build"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "3.2.4",
    "turbo": "^2.0.0",
    "typescript": "5.3.3"
  },
  "volta": {
    "node": "24.14.0"
  }
}
