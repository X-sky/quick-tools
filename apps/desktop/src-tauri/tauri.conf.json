{
  "productName": "Quick Tools",
  "version": "0.1.0",
  "identifier": "com.quick-tools.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Quick Tools",
        "width": 1024,
        "height": 768,
        "minWidth": 900,
        "minHeight": 640,
        "label": "main"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "$schema": "https://schema.tauri.app/config/2"
}
