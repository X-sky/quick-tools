# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE / editor
.vscode/
.cursor/
.idea/

# local AI specs / hooks / steering（本机内容，不入库）
.kiro/

# playwright
.playwright-cli/

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
coverage/

# cache
.turbo/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local env files
.env*

# build outputs — monorepo
packages/*/dist/
apps/*/dist/
apps/extension/build/
out/

# plasmo (extension)
.plasmo/
apps/extension/.plasmo/

# tauri (desktop)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# 由 apps/desktop/scripts/prepare-pdf-fonts.mjs 生成
apps/desktop/public/fonts/*.fixed.ttf

# pnpm store (local)
.pnpm-store/

# bpp - http://bpp.browser.market/
keys.json

# typescript
*.tsbuildinfo

# vitest
*.vitest.timestamp*

# eslint
.eslintcache
